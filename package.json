{
  "name": "greyo-frontend",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "entities",
    "core",
    "application",
    "infrastructure",
    "di",
    "assets",
    "design-system",
    "presentation"
  ],
  "//": "외부 의존성 single source — 루트에서 한 번만 정확한 버전으로 선언(hoist)한다. sub-package 는 @greyo-frontend/* internal 만 명시하고 외부는 여기서 hoist 받아 쓴다.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=presentation",
    "preview": "npm run preview --workspace=presentation",
    "routes": "npm run routes --workspace=presentation",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=presentation",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@react-router/node": "8.3.1",
    "axios": "1.20.0",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
