{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["APP_ENV", "VITE_APP_ENV", "VITE_API_URL", "VITE_SITE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".react-router/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
